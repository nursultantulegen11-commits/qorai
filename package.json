{
  "name": "qorai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/copy-static.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/suppliers.test.ts tests/security.test.ts tests/backup.test.ts",
    "test:api": "node --experimental-strip-types --test tests/api.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "@types/pg": "8.23.1"
  }
}
